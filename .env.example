# J.A.R.V.I.S. — Environment Configuration
# Copy to .env and fill in values before running.

# --- Redis ---
REDIS_URL=redis://:jarvis_redis_pass@redis:6379/0
REDIS_PASSWORD=jarvis_redis_pass

# --- LLM Providers ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:8b

# LLM Cloud Fallbacks (optional — leave empty to skip)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- STT ---
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# --- TTS ---
TTS_PROVIDER=piper
TTS_VOICE=default

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- WebSocket Auth ---
WS_API_KEY=dev-insecure-key-change-in-production

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=60/minute
