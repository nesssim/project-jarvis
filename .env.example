# J.A.R.V.I.S. — Environment Configuration
# Copy to .env and fill in values before running.

# --- Redis ---
REDIS_URL=redis://:CHANGE_ME_STRONG_PASSWORD_12345@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_12345

# --- LLM Providers ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:8b

# LLM Cloud Fallbacks (optional — leave empty to skip)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Reserved for future cloud providers (not wired up in code yet)
OPENROUTER_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# --- STT ---
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# --- TTS ---
TTS_PROVIDER=piper
TTS_VOICE=default

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- WebSocket Auth ---
WS_API_KEY=dev-insecure-key-change-in-production

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=60/minute

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Service Auth ---
AUTH_ENABLED=false
AUTH_API_KEY=
